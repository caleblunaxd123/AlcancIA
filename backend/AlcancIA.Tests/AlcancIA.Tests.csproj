    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Needed for WebApplicationFactory integration tests against the API. -->
  <ItemGroup>
