# Base URL del backend AlcancIA (.NET).
# - Emulador Android: usa `adb reverse tcp:5080 tcp:5080` y deja http://127.0.0.1:5080
# - Dispositivo físico: IP LAN del equipo que corre el backend, ej. http://192.168.1.10:5080
# - Producción: URL HTTPS desplegada, ej. https://api.alcancia.app
#   En builds de release es OBLIGATORIA y debe ser https:// (si no, la app no se
#   conecta: nunca envía credenciales por HTTP). Para EAS se define como variable
#   de entorno del proyecto (ver docs/DEPLOY.md), no en este archivo.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5080

# --- Inicio de sesión social (IDs públicos de OAuth, no son secretos) ---
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth.
# Android: tipo "Android" con package com.alcancia.app + SHA-1 del keystore.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Meta for Developers > tu app > Configuración básica > Identificador de la app.
EXPO_PUBLIC_FACEBOOK_APP_ID=
