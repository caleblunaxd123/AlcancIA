# AlcancIA — variables de entorno (ejemplo). Copia a .env y completa.
# Nunca subas secretos reales al repositorio.

# --- App ---
APP_ENV=development

# --- Backend (.NET, planificado) ---
DATABASE_CONNECTION=
JWT_SECRET=
JWT_ISSUER=alcancia
JWT_AUDIENCE=alcancia-app

# --- IA (abstracción IAiProvider; el modelo NO se hardcodea) ---
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=

# --- Feature flags ---
AI_ENABLED=true
HOUSEHOLD_ENABLED=true
SCANNER_ENABLED=false
CHALLENGES_ENABLED=true
PREMIUM_ENABLED=false
DEV_TOOLS_ENABLED=true
